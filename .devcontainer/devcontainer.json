{
  "name": "HPC & Quantum Strategy Lab",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "minimal"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "C_Cpp.default.compilerPath": "/usr/bin/gcc"
      },
      "extensions": [
        "ms-vscode.cpptools",
        "rust-lang.rust-analyzer",
        "myriad-dreamin.tinymist",
        "tomoki1207.pdf",
        "github.copilot",
        "ms-python.python"
      ]
    }
  },
  // 変更点1: sudoを排除し、uvもtypstも $HOME/.local/bin にインストール・配置する
  "postCreateCommand": "mkdir -p $HOME/.local/bin && curl -LsSf https://astral.sh/uv/install.sh | sh && curl -L https://github.com/typst/typst/releases/latest/download/typst-x86_64-unknown-linux-musl.tar.xz | tar -xJ && mv typst-x86_64-unknown-linux-musl/typst $HOME/.local/bin/ && rm -rf typst-x86_64-unknown-linux-musl",
  
  // 変更点2: $HOME/.local/bin にパスを通し、コンテナ起動直後から uv と typst を使えるようにする
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.local/bin:${containerEnv:PATH}"
  },
  
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}"
}